---
// The next 12 months at a glance: one column per month, one coloured mark per deadline.
// Each month links to its list further down the calendar page. Built at build time (the site rebuilds daily).
import { getUpcomingDeadlines } from '../lib/content';
import { dateLocale, fill, useTranslations, type Lang } from '../i18n';
import { deadlineTypes } from '../lib/taxonomy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const locale = lang === 'ar' ? 'ar-u-nu-latn' : dateLocale(lang);
const deadlines = await getUpcomingDeadlines();

const now = new Date();
const months = Array.from({ length: 12 }, (_, i) => {
  const date = new Date(now.getFullYear(), now.getMonth() + i, 1);
  const key = `${date.getFullYear()}-${date.getMonth()}`;
  const items = deadlines.filter((d) => d.data.date.getFullYear() === date.getFullYear() && d.data.date.getMonth() === date.getMonth());
  return {
    key,
    short: date.toLocaleDateString(locale, { month: 'short' }),
    long: date.toLocaleDateString(locale, { month: 'long', year: 'numeric' }),
    year: date.getMonth() === 0 || i === 0 ? String(date.getFullYear()) : '',
    items,
  };
});
type TypeKey = keyof typeof deadlineTypes;
const usedTypes = (Object.keys(deadlineTypes) as TypeKey[]).filter((k) => deadlines.some((d) => d.data.type === k));
const formatDay = (d: Date) => d.toLocaleDateString(locale, { day: 'numeric', month: 'short' });
---

{deadlines.length > 0 && (
  <section class="deadline-year" aria-labelledby="deadline-year-title">
    <h2 id="deadline-year-title">{t('calendar.year.title')}</h2>
    <p class="meta">{t('calendar.year.intro')}</p>
    <ol class="deadline-year__months">
      {months.map((m, i) => (
        <li class:list={['deadline-year__month', { 'is-now': i === 0, 'is-empty': m.items.length === 0 }]}>
          {m.items.length > 0 ? (
            <a href={`#m-${m.key}`} aria-label={`${m.long}: ${fill(t(m.items.length === 1 ? 'calendar.year.countOne' : 'calendar.year.count'), { n: m.items.length })}`}>
              <span class="deadline-year__marks">
                {m.items.map((d) => (
                  <span class={`deadline-year__mark type-${d.data.type}`} title={`${formatDay(d.data.date)}: ${d.data.title[lang]}`} />
                ))}
              </span>
              <span class="deadline-year__name">{m.short}</span>
            </a>
          ) : (
            <span aria-label={`${m.long}: ${t('calendar.year.none')}`}>
              <span class="deadline-year__marks" />
              <span class="deadline-year__name">{m.short}</span>
            </span>
          )}
          <span class="deadline-year__year">{m.year}</span>
        </li>
      ))}
    </ol>
    <ul class="deadline-year__legend">
      {usedTypes.map((k) => (
        <li><span class={`deadline-year__mark type-${k}`} aria-hidden="true" /> {deadlineTypes[k][lang]}</li>
      ))}
    </ul>
  </section>
)}

<style>
  .deadline-year {
    background: var(--color-primary-soft);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .deadline-year h2 {
    margin-block-start: 0;
  }
  .deadline-year__months {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0.5rem;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.25rem;
  }
  .deadline-year__month > a,
  .deadline-year__month > span:first-child {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.1rem;
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    block-size: 100%;
  }
  .deadline-year__month > a:hover,
  .deadline-year__month > a:focus-visible {
    background: var(--color-surface);
  }
  .deadline-year__month.is-now > a,
  .deadline-year__month.is-now > span:first-child {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .deadline-year__marks {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: flex-start;
    gap: 3px;
    min-block-size: 5.5rem;
  }
  .deadline-year__mark {
    display: inline-block;
    inline-size: 0.8rem;
    block-size: 0.8rem;
    border-radius: 50%;
    background: var(--color-muted);
  }
  .deadline-year__mark.type-application { background: var(--color-primary); }
  .deadline-year__mark.type-pre_enrolment { background: #3b82f6; }
  .deadline-year__mark.type-test { background: #a855f7; }
  .deadline-year__mark.type-scholarship { background: #e0a800; }
  .deadline-year__mark.type-visa { background: var(--color-accent); }
  .deadline-year__name {
    font-size: 0.8rem;
    font-weight: 600;
  }
  .deadline-year__month.is-empty .deadline-year__name {
    color: var(--color-muted);
    font-weight: 400;
  }
  .deadline-year__year {
    display: block;
    text-align: center;
    font-size: 0.7rem;
    color: var(--color-muted);
    min-block-size: 1em;
  }
  .deadline-year__legend {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.85rem;
  }
  .deadline-year__legend li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  @media (max-width: 34rem) {
    .deadline-year__months {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 0.75rem;
    }
  }
</style>
