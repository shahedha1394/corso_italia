---
// Renders a date-time on the server in Rome time, then the browser rewrites it in the visitor's own time zone.
// Date-only values (dateOnly) are shown as the same calendar day everywhere.
import type { Lang } from '../i18n';

interface Props {
  date: Date;
  lang: Lang;
  dateOnly?: boolean;
}

const { date, lang, dateOnly = false } = Astro.props;
const locale = lang === 'ar' ? 'ar' : 'en-GB';
const options: Intl.DateTimeFormatOptions = dateOnly
  ? { dateStyle: 'full', timeZone: 'UTC' }
  : { dateStyle: 'full', timeStyle: 'short', timeZone: 'Europe/Rome' };
---

<time datetime={date.toISOString()} data-local={dateOnly ? 'date' : 'datetime'} data-locale={locale}>
  {date.toLocaleString(locale, options)}
</time>

<script>
  for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-local]')) {
    const date = new Date(el.dateTime);
    const options: Intl.DateTimeFormatOptions =
      // Date-only values (deadlines) are calendar days, so they must not shift with the time zone.
      el.dataset.local === 'date' ? { dateStyle: 'full', timeZone: 'UTC' } : { dateStyle: 'full', timeStyle: 'short' };
    el.textContent = date.toLocaleString(el.dataset.locale, options);
  }
</script>
