---
import '../styles/global.css';
import { languages, langs, useTranslations, path, switchLangPath, type Lang } from '../i18n';
import Icon from '../components/Icon.astro';
import { goatcounter, social } from '../config/site';
import { getVideos } from '../lib/content';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const dir = languages[lang].dir;
const pageTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} · ${t('site.tagline')}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = Astro.url.pathname.slice(base.length).replace(/^\/(en|ar|fr)(?=\/|$)/, '') || '/';
const current = Astro.url.pathname;
const pageDescription = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og-image.jpg`, Astro.site).href;
const ogLocale = { en: 'en_GB', ar: 'ar_AR', fr: 'fr_FR' }[lang];

const nav = [
  { href: path(lang, '/study/'), label: t('nav.study') },
  { href: path(lang, '/living/'), label: t('nav.living') },
  { href: path(lang, '/engpro/'), label: t('nav.engpro') },
  { href: path(lang, '/opportunities/'), label: t('nav.opportunities') },
  { href: path(lang, '/about/'), label: t('nav.about') },
];
// The Videos link appears only once there is at least one video.
if ((await getVideos()).length > 0) nav.splice(3, 0, { href: path(lang, '/videos/'), label: t('nav.videos') });
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.ogAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(path(l, rest), Astro.site)} />)}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+Arabic:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">{t('common.skip')}</a>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href={path(lang)}>
          <img class="brand-logo" src={`${base}/logo.svg`} alt="" width="32" height="32" />
          {t('site.name')}
        </a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
          {t('nav.menu')}
        </button>
        <nav id="site-nav" class="site-nav" aria-label={t('nav.menu')}>
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="lang-switch" aria-label={t('lang.choose')}>
          {langs
            .filter((l) => l !== lang)
            .map((l) => (
              <a href={switchLangPath(Astro.url.pathname, l)} hreflang={l} lang={l} aria-label={languages[l].label}>
                <span class="lang-full">{languages[l].label}</span>
                <span class="lang-short" aria-hidden="true">{languages[l].short}</span>
              </a>
            ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <p>{t('footer.free')} {t('common.disclaimer')}</p>
        <ul class="footer-links">
          <li><a href={path(lang, '/faq/')}>{t('footer.faq')}</a></li>
          <li><a href={path(lang, '/contact/')}>{t('footer.contact')}</a></li>
          <li><a href={path(lang, '/disclaimer/')}>{t('footer.disclaimer')}</a></li>
          <li><a href={path(lang, '/privacy/')}>{t('footer.privacy')}</a></li>
        </ul>
        <div class="footer-social">
          <span>{t('footer.follow')}</span>
          <a href={social.instagram} rel="noopener me" target="_blank" aria-label="Instagram" title="Instagram">
            <Icon name="instagram" size={22} />
          </a>
          <a href={social.youtube} rel="noopener me" target="_blank" aria-label="YouTube" title="YouTube">
            <Icon name="youtube" size={22} />
          </a>
        </div>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.menu-button');
      const nav = document.getElementById('site-nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
    </script>
    {goatcounter && (
      <script is:inline data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
    )}
  </body>
</html>
