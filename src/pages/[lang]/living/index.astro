---
import Base from '../../../layouts/Base.astro';
import GuideCards from '../../../components/GuideCards.astro';
import { getStaticLangPaths, useTranslations, type Lang } from '../../../i18n';
import { getGuides } from '../../../lib/content';

export const getStaticPaths = getStaticLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const guides = await getGuides(lang, 'living');
---

<Base lang={lang} title={t('living.title')} description={t('living.intro')}>
  <header class="container page-header">
    <h1>{t('living.title')}</h1>
    <p>{t('living.intro')}</p>
  </header>

  <section class="container section">
    <h2>{t('living.guides')}</h2>
    <GuideCards lang={lang} guides={guides} />
  </section>
</Base>
