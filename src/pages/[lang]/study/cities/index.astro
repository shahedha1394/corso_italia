---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { getStaticLangPaths, path, useTranslations, type Lang } from '../../../../i18n';
import { cities, regions } from '../../../../lib/taxonomy';

export const getStaticPaths = getStaticLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const [universities, cityInfo] = await Promise.all([getCollection('universities'), getCollection('cities')]);
const descriptions = new Map(cityInfo.map((c) => [c.id, c.data.description]));

type CityKey = keyof typeof cities;
const cityKeys = [...new Set(universities.map((u) => u.data.city))] as CityKey[];
const cityList = cityKeys
  .map((city) => {
    const unis = universities
      .filter((u) => u.data.city === city)
      .sort((a, b) => a.data.name[lang].localeCompare(b.data.name[lang], lang));
    return {
      city,
      region: unis[0].data.region,
      description: descriptions.get(city),
      unis,
    };
  })
  .sort((a, b) => cities[a.city][lang].localeCompare(cities[b.city][lang], lang));
---

<Base lang={lang} title={t('cities.title')} description={t('cities.intro')}>
  <header class="container page-header">
    <p class="meta"><a href={path(lang, '/study/')}>{t('nav.study')}</a></p>
    <h1>{t('cities.title')}</h1>
    <p>{t('cities.intro')}</p>
  </header>

  <section class="container section">
    <div class="city-groups">
      {cityList.map((c) => (
        <details class="city-group" id={c.city}>
          <summary>
            <span class="city-name">{cities[c.city][lang]}</span>
            <span class="meta">{regions[c.region][lang]}</span>
            <span class="city-count">{c.unis.length}</span>
          </summary>
          <div class="city-body">
            {c.description && <p>{c.description[lang]}</p>}
            <ul class="city-unis">
              {c.unis.map((u) => (
                <li><a href={path(lang, `/study/universities/${u.id}/`)}>{u.data.name[lang]}</a></li>
              ))}
            </ul>
          </div>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .city-groups {
    display: grid;
    gap: 0.5rem;
  }
  .city-group {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .city-group > summary {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
  }
  .city-name {
    font-weight: 600;
  }
  .city-count {
    margin-inline-start: auto;
    font-size: 0.8rem;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  .city-body {
    padding: 0 1rem 0.75rem;
  }
  .city-body p {
    margin-block: 0 0.5rem;
    color: var(--color-muted);
  }
  .city-unis {
    margin: 0;
    padding-inline-start: 1.25rem;
  }
</style>

<script>
  // Links like /study/cities/#roma open that city.
  const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
  if (target instanceof HTMLDetailsElement) {
    target.open = true;
    target.scrollIntoView();
  }
</script>
