---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { arrow, fill, langs, path, useTranslations, type Lang } from '../../../../i18n';
import { getPrograms } from '../../../../lib/content';
import { cities, fields, levels, regions, teachingLanguages } from '../../../../lib/taxonomy';

export async function getStaticPaths() {
  const programs = await getCollection('programs');
  return langs.flatMap((lang) => programs.map((p) => ({ params: { lang, slug: p.id } })));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const program = (await getPrograms(lang)).find((p) => p.id === Astro.params.slug)!;
const p = program.data;
const u = program.uni.data;
const locale = lang === 'ar' ? 'ar' : 'en-GB';
const formatDate = (d: Date) => d.toLocaleDateString(locale, { dateStyle: 'long' });
const checked = formatDate(p.last_checked);
const deadlines = [...p.deadlines].sort((a, b) => a.date.getTime() - b.date.getTime());
const euros = (n: number) => n.toLocaleString(locale);
---

<Base lang={lang} title={p.name[lang]} description={`${p.name[lang]} · ${u.name[lang]}`}>
  <article class="container prose program-page">
    <header class="page-header">
      <p class="meta"><a href={path(lang, '/study/programs/')}>{t('dir.programs.title')}</a></p>
      <span class="badge">{levels[p.level][lang]}</span>
      <h1>{p.name[lang]}</h1>
      <p>
        <a href={path(lang, `/study/universities/${program.uni.id}/`)}>{u.name[lang]}</a> · {cities[u.city][lang]}
      </p>
    </header>

    {p.description && <p>{p.description[lang]}</p>}

    <p><a class="button" href={p.url} rel="noopener" target="_blank">{t('dir.program.official')}</a></p>

    <!-- Every program page has the same sections, in the same order. -->
    <section>
      <h2>{t('dir.program.glance')}</h2>
      <dl class="facts">
        <dt>{t('dir.filter.level')}</dt>
        <dd>{levels[p.level][lang]}{p.single_cycle && <><br /><span class="meta">{t('dir.program.singleCycle')}</span></>}</dd>
        <dt>{t('dir.filter.field')}</dt>
        <dd>{fields[p.field][lang]}</dd>
        <dt>{t('dir.filter.language')}</dt>
        <dd>{teachingLanguages[p.language][lang]}</dd>
        <dt>{t('dir.program.duration')}</dt>
        <dd>{fill(t('dir.program.years'), { n: p.duration_years })}</dd>
        <dt>{t('dir.filter.city')}</dt>
        <dd>{cities[u.city][lang]}, {regions[u.region][lang]}</dd>
      </dl>
    </section>

    <section>
      <h2>{t('dir.program.requirements')}</h2>
      <dl class="facts">
        <dt>{t('dir.program.test')}</dt>
        <dd>{p.admission_test ? <span class="ltr-inline">{p.admission_test}</span> : <span class="meta">{t('dir.program.missing')}</span>}</dd>
        <dt>{t('dir.program.languageReq')}</dt>
        <dd>
          {p.language_requirement ? <span class="ltr-inline">{p.language_requirement}</span> : <span class="meta">{t('dir.program.missing')}</span>}
          <br /><a href={path(lang, '/study/language-requirements/')}>{t('dir.program.languageReqGuide')} {arrow(lang)}</a>
        </dd>
      </dl>
      {p.required_documents.length > 0 && (
        <>
          <h3>{t('dir.program.documents')}</h3>
          <ul>
            {p.required_documents.map((d) => <li>{d[lang]}</li>)}
          </ul>
        </>
      )}
    </section>

    <section>
      <h2>{t('dir.program.deadlines')}</h2>
      {deadlines.length > 0 ? (
        <dl class="facts">
          {deadlines.map((d) => (
            <>
              <dt>{d.label[lang]}</dt>
              <dd>{formatDate(d.date)}</dd>
            </>
          ))}
        </dl>
      ) : (
        <p class="meta">{t('dir.program.missing')}</p>
      )}
    </section>

    <section>
      <h2>{t('dir.program.fees')}</h2>
      {p.tuition_eur ? (
        <p>{fill(t('dir.program.feesRange'), { min: euros(p.tuition_eur.min), max: euros(p.tuition_eur.max) })}</p>
      ) : (
        <p class="meta">{t('dir.program.missing')}</p>
      )}
      <p class="meta">
        {t('dir.program.feesNote')} <a href={path(lang, '/study/funding/')}>{t('dir.funding.guide')} {arrow(lang)}</a>
      </p>
    </section>

    <section>
      <h2>{t('dir.program.howToApply')}</h2>
      <ol class="apply-steps">
        <li>{t('dir.program.step1')}</li>
        <li>{t('dir.program.step2')}</li>
        <li>{t('dir.program.step3')}</li>
        <li>{t('dir.program.step4')}</li>
      </ol>
      {p.application_url && (
        <p><a class="button" href={p.application_url} rel="noopener" target="_blank">{t('dir.program.apply')}</a></p>
      )}
      <p><a href={path(lang, '/study/how-to-apply/')}>{t('dir.program.howToApply')} {arrow(lang)}</a></p>
    </section>

    <p class="meta">{t('common.lastChecked')}: {checked}</p>
    <p class="notice">{t('common.disclaimer')}</p>
  </article>
</Base>

<style>
  .program-page section {
    border-block-start: 1px solid var(--color-border);
    margin-block-start: 1.5rem;
  }
  .apply-steps {
    padding-inline-start: 1.25rem;
  }
  .apply-steps li {
    margin-block-end: 0.4rem;
  }
</style>
