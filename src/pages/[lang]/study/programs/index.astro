---
import Base from '../../../../layouts/Base.astro';
import ProgramCard from '../../../../components/ProgramCard.astro';
import { getStaticLangPaths, useTranslations, type Lang } from '../../../../i18n';
import { getPrograms } from '../../../../lib/content';
import { normalize } from '../../../../lib/search';
import { cities, fields, levels, teachingLanguages } from '../../../../lib/taxonomy';

export const getStaticPaths = getStaticLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const programs = await getPrograms(lang);

// Only offer filter values that at least one program uses.
const used = <K extends string>(get: (p: (typeof programs)[number]) => K) => [...new Set(programs.map(get))];
const cityOptions = used((p) => p.uni.data.city).sort((a, b) => cities[a][lang].localeCompare(cities[b][lang], lang));
const levelOptions = (Object.keys(levels) as (keyof typeof levels)[]).filter((l) => programs.some((p) => p.data.level === l));
const langOptions = used((p) => p.data.language);
const fieldOptions = used((p) => p.data.field);
const uniOptions = [...new Map(programs.map((p) => [p.uni.id, p.uni])).values()].sort((a, b) =>
  a.data.name[lang].localeCompare(b.data.name[lang], lang),
);

const searchText = (p: (typeof programs)[number]) =>
  normalize(
    [
      p.data.name.en,
      p.data.name.ar,
      ...p.data.keywords,
      p.uni.data.name.en,
      p.uni.data.name.ar,
      p.uni.data.name_it,
      cities[p.uni.data.city].en,
      cities[p.uni.data.city].ar,
      fields[p.data.field].en,
      fields[p.data.field].ar,
    ].join(' '),
  );

const filters = [
  { name: 'city', label: t('dir.filter.city'), options: cityOptions.map((c) => [c, cities[c][lang]]) },
  { name: 'university', label: t('dir.filter.university'), options: uniOptions.map((u) => [u.id, u.data.name[lang]]) },
  { name: 'level', label: t('dir.filter.level'), options: levelOptions.map((l) => [l, levels[l][lang]]) },
  { name: 'language', label: t('dir.filter.language'), options: langOptions.map((l) => [l, teachingLanguages[l][lang]]) },
  { name: 'field', label: t('dir.filter.field'), options: fieldOptions.map((f) => [f, fields[f][lang]]) },
];
---

<Base lang={lang} title={t('dir.programs.title')} description={t('dir.programs.intro')}>
  <header class="container page-header">
    <h1>{t('dir.programs.title')}</h1>
    <p>{t('dir.programs.intro')}</p>
  </header>

  <section class="container section">
    <p class="notice">{t('dir.seedNotice')}</p>

    <form class="filters" id="program-filters" role="search" onsubmit="return false">
      <label class="filter-search">
        <span>{t('dir.search.label')}</span>
        <input type="search" name="q" placeholder={t('dir.search.placeholder')} autocomplete="off" />
      </label>
      {filters.map((f) => (
        <label>
          <span>{f.label}</span>
          <select name={f.name}>
            <option value="">{t('dir.filter.all')}</option>
            {f.options.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
      ))}
      <button type="reset" class="link-button">{t('dir.filter.reset')}</button>
    </form>

    <p class="meta" id="result-count" aria-live="polite" data-template={t('dir.results.count')}>
      {t('dir.results.count').replace('{n}', String(programs.length))}
    </p>

    <div class="grid" id="program-list">
      {programs.map((p) => (
        <div
          class="program-item"
          data-city={p.uni.data.city}
          data-university={p.uni.id}
          data-level={p.data.level}
          data-language={p.data.language}
          data-field={p.data.field}
          data-text={searchText(p)}
        >
          <ProgramCard lang={lang} program={p} />
        </div>
      ))}
    </div>
    <p class="card" id="no-results" hidden>{t('dir.results.none')}</p>
  </section>
</Base>

<script>
  import { normalize } from '../../../../lib/search';

  const form = document.getElementById('program-filters') as HTMLFormElement;
  const items = [...document.querySelectorAll<HTMLElement>('.program-item')];
  const count = document.getElementById('result-count')!;
  const none = document.getElementById('no-results')!;
  const selects = ['city', 'university', 'level', 'language', 'field'];

  // Restore filters from the URL so a search can be shared as a link.
  const params = new URLSearchParams(location.search);
  for (const [key, value] of params) {
    const el = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null;
    if (el) el.value = value;
  }

  function apply() {
    const data = new FormData(form);
    const words = normalize(String(data.get('q') ?? '')).split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const matches =
        selects.every((s) => !data.get(s) || item.dataset[s] === data.get(s)) &&
        words.every((w) => item.dataset.text!.includes(w));
      item.hidden = !matches;
      if (matches) shown++;
    }
    count.textContent = count.dataset.template!.replace('{n}', String(shown));
    none.hidden = shown > 0;

    const next = new URLSearchParams();
    for (const [k, v] of data) if (v) next.set(k, String(v));
    const query = next.toString();
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
  }

  form.addEventListener('input', apply);
  form.addEventListener('reset', () => setTimeout(apply));
  apply();
</script>
