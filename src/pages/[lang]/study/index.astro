---
import Base from '../../../layouts/Base.astro';
import GuideCards from '../../../components/GuideCards.astro';
import { getStaticLangPaths, path, useTranslations, type Lang } from '../../../i18n';
import { getGuides } from '../../../lib/content';

export const getStaticPaths = getStaticLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const guides = await getGuides(lang, 'study');
---

<Base lang={lang} title={t('study.title')} description={t('study.intro')}>
  <header class="container page-header">
    <h1>{t('study.title')}</h1>
    <p>{t('study.intro')}</p>
  </header>

  <section class="container section">
    <h2>{t('study.directory.title')}</h2>
    <div class="grid">
      <a class="card" href={path(lang, '/study/programs/')}>
        <h3>{t('dir.programs.title')}</h3>
        <p>{t('study.directory.programs')}</p>
      </a>
      <a class="card" href={path(lang, '/study/universities/')}>
        <h3>{t('dir.universities.title')}</h3>
        <p>{t('study.directory.universities')}</p>
      </a>
      <a class="card" href={path(lang, '/study/scholarships/')}>
        <h3>{t('dir.funding.title')}</h3>
        <p>{t('study.directory.funding')}</p>
      </a>
    </div>
  </section>

  <section class="container section">
    <h2>{t('study.guides')}</h2>
    <GuideCards lang={lang} guides={guides} />
  </section>
</Base>
