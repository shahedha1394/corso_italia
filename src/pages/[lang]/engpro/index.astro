---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import SignupButton from '../../../components/SignupButton.astro';
import { engproTeachers } from '../../../config/engpro-teachers';
import { getStaticLangPaths, path, useTranslations, type Lang } from '../../../i18n';
import { forms } from '../../../config/forms';
import { skills } from '../../../lib/taxonomy';

export const getStaticPaths = getStaticLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const resources = (await getCollection('engpro-resources')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const levelRange = (levels: string[]) => (levels.length > 1 ? `${levels[0]}–${levels[levels.length - 1]}` : levels[0]);
---

<Base lang={lang} title={t('engpro.title')} description={t('engpro.tagline')}>
  <header class="engpro-hero">
    <div class="container">
      <span class="engpro-logo">
        <img src={`${base}/engpro-logo.png`} alt={t('engpro.logoAlt')} width="250" height="217" />
      </span>
      <h1>{t('engpro.title')}</h1>
      <p class="tagline">{t('engpro.tagline')}</p>
      <p>{t('engpro.intro')}</p>
      <p><a class="hero-link" href={path(lang, '/engpro-code-of-conduct/')}>{t('engpro.conduct')}</a></p>
    </div>
  </header>

  <section class="container section">
    <div class="grid">
      <div class="card">
        <h2>{t('engpro.learners.title')}</h2>
        <p>{t('engpro.learners.text')}</p>
        <p><SignupButton lang={lang} href={forms.engproLearner} label={t('engpro.learners.cta')} /></p>
      </div>
      <div class="card">
        <h2>{t('engpro.teachers.title')}</h2>
        <p>{t('engpro.teachers.text')}</p>
        <p><SignupButton lang={lang} href={forms.engproTeacher} label={t('engpro.teachers.cta')} /></p>
      </div>
    </div>
  </section>

  {engproTeachers.length > 0 && (
    <section class="container section thanks">
      <h2><Icon name="heart" size={26} class="thanks__icon" /> {t('engpro.thanks.title')}</h2>
      <p class="thanks__text">{t('engpro.thanks.text')}</p>
      <ul class="thanks__list">
        {engproTeachers.map((teacher) => (
          <li>
            <span class="thanks__name ltr-inline" lang="en">{teacher.name}</span>
            <span class="meta">{teacher.country[lang]}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container section">
    <h2>{t('engpro.resources.title')}</h2>
    <p class="meta">{t('engpro.resources.intro')}</p>
    <div class="grid">
      {resources.map((r) => (
        <a class="card" href={r.data.url} rel="noopener" target="_blank">
          <span class="badge">{skills[r.data.skill][lang]} · <span class="ltr-inline">{levelRange(r.data.levels)}</span></span>
          <h3 class="ltr-inline">{r.data.title}</h3>
          <p>{r.data.description[lang]}</p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  /* EngPro has its own look, separate from the study section */
  .engpro-hero {
    /* Teal taken from the green in the EngPro logo, darkened so white text stays readable */
    background: linear-gradient(135deg, #005f54, #007d6c);
    color: #fff;
    padding-block: 3rem;
  }
  /* The circle is on the wrapper; the logo is smaller than the circle so its corners are not cut */
  .engpro-logo {
    display: grid;
    place-items: center;
    inline-size: 8rem;
    block-size: 8rem;
    margin-block-end: 1.25rem;
    background: rgba(255, 255, 255, 0.92);
    border: 3px solid #00b39a;
    border-radius: 50%;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }
  .engpro-logo img {
    inline-size: 62%;
    block-size: auto;
  }
  .engpro-hero h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .engpro-hero .tagline {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0.25rem 0 1rem;
  }
  .engpro-hero p {
    max-inline-size: 45rem;
  }
  .hero-link {
    color: #fff;
  }
  .thanks {
    background: #e6f4f1;
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .thanks h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0;
    color: #005f54;
  }
  .thanks :global(.thanks__icon) {
    color: #b3261e;
    fill: #b3261e;
  }
  .thanks__text {
    max-inline-size: 45rem;
  }
  .thanks__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
  }
  .thanks__list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid #00b39a;
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }
  .thanks__name {
    font-weight: 600;
  }
  @media (prefers-color-scheme: dark) {
    .thanks {
      background: #13302b;
    }
    .thanks h2 {
      color: #7fd8c6;
    }
  }
</style>
