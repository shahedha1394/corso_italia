---
// Language chooser at the site root. Visitors pick Arabic, English or French;
// every other page lives under /en/, /ar/ or /fr/.
import '../styles/global.css';
import { path } from '../i18n';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Corso Italy</title>
    <meta name="description" content="Study and live in Italy, step by step. الدراسة والحياة في إيطاليا، خطوة بخطوة. Étudier et vivre en Italie, étape par étape." />
    <link rel="alternate" hreflang="en" href={path('en')} />
    <link rel="alternate" hreflang="ar" href={path('ar')} />
    <link rel="alternate" hreflang="fr" href={path('fr')} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+Arabic:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="container chooser">
      <img class="big-logo" src={`${base}/logo.svg`} alt="" width="72" height="72" />
      <h1>Corso Italy</h1>
      <p lang="ar" dir="rtl" class="ar">الدراسة والحياة في إيطاليا، خطوة بخطوة</p>
      <p>Study and live in Italy, step by step</p>
      <p lang="fr">Étudier et vivre en Italie, étape par étape</p>
      <div class="choices">
        <a class="button ar" href={path('ar')} hreflang="ar" lang="ar">العربية</a>
        <a class="button" href={path('en')} hreflang="en">English</a>
        <a class="button" href={path('fr')} hreflang="fr" lang="fr">Français</a>
      </div>
    </main>
    <style>
      .chooser {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 0.25rem;
      }
      .chooser h1 {
        margin: 1rem 0 0.5rem;
        font-size: 2.5rem;
      }
      .chooser p {
        margin: 0;
        color: var(--color-muted);
      }
      .ar {
        font-family: var(--font-arabic);
      }
      .choices {
        display: flex;
        gap: 1rem;
        margin-block-start: 2rem;
        flex-wrap: wrap;
        justify-content: center;
      }
      .big-logo {
        display: block;
        width: 4.5rem;
        height: 4.5rem;
      }
    </style>
  </body>
</html>
