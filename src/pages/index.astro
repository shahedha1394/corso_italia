---
// Language chooser at the site root. Visitors pick Arabic, English or French;
// every other page lives under /en/, /ar/ or /fr/.
import '../styles/global.css';
import { path } from '../i18n';
import { goatcounter } from '../config/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description =
  'Study and live in Italy, step by step. الدراسة والحياة في إيطاليا، خطوة بخطوة. Étudier et vivre en Italie, étape par étape.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og-image.jpg`, Astro.site).href;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Corso Italy</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Corso Italy" />
    <meta property="og:title" content="Corso Italy" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Corso Italy: study and live in Italy" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="en" href={path('en')} />
    <link rel="alternate" hreflang="ar" href={path('ar')} />
    <link rel="alternate" hreflang="fr" href={path('fr')} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
  </head>
  <body>
    <main class="container chooser">
      <img class="big-logo" src={`${base}/logo.svg`} alt="" width="72" height="72" />
      <h1>Corso Italy</h1>
      <p lang="ar" dir="rtl" class="ar">الدراسة والحياة في إيطاليا، خطوة بخطوة</p>
      <p>Study and live in Italy, step by step</p>
      <p lang="fr">Étudier et vivre en Italie, étape par étape</p>
      <div class="choices">
        <a class="button ar" href={path('ar')} hreflang="ar" lang="ar">العربية</a>
        <a class="button" href={path('en')} hreflang="en">English</a>
        <a class="button" href={path('fr')} hreflang="fr" lang="fr">Français</a>
      </div>
    </main>
    <style>
      .chooser {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 0.25rem;
      }
      .chooser h1 {
        margin: 1rem 0 0.5rem;
        font-size: 2.5rem;
      }
      .chooser p {
        margin: 0;
        color: var(--color-muted);
      }
      .ar {
        font-family: var(--font-arabic);
      }
      .choices {
        display: flex;
        gap: 1rem;
        margin-block-start: 2rem;
        flex-wrap: wrap;
        justify-content: center;
      }
      .big-logo {
        display: block;
        width: 4.5rem;
        height: 4.5rem;
      }
    </style>
    {goatcounter && (
      <script is:inline data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
    )}
  </body>
</html>
